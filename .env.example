# API
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Workspace (mounted volume for input/output)
WORKSPACE_DIR=/data/workspace

# GDAL performance
GDAL_CACHEMAX=512

# Job retention (seconds)
JOB_TTL=604800

# Imagery tile publishing (nginx)
IMAGERY_SERVER_PUBLIC_URL=http://localhost:8102
IMAGERY_BASE_PATH=/imagery
AUTO_PUBLISH=false

# Default tiling options (request may still override)
# TILING_THREAD_COUNT=4
TILING_RESUME=false
