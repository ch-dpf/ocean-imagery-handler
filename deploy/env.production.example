# Production environment for bare-metal deployment.
# Copy to /etc/ocean-imagery-handler/env and adjust values.

APP_HOST=0.0.0.0
APP_PORT=8100
APP_DEBUG=false

# Local Redis (default port 6379)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Data root — must match nginx alias paths in deploy/nginx-baremetal.conf
WORKSPACE_DIR=/var/lib/ocean-imagery-handler/data

GDAL_CACHEMAX=512
JOB_TTL=604800

# Browser multipart upload limit (bytes). Default 2GiB; larger files use workspace path.
MAX_UPLOAD_BYTES=2147483648

# Public URL clients use to fetch tiles (hostname/IP + nginx listen port)
IMAGERY_SERVER_PUBLIC_URL=http://your-server:8102
IMAGERY_BASE_PATH=/imagery
AUTO_PUBLISH=false

# TILING_THREAD_COUNT=4
TILING_RESUME=false
