[Unit]
Description=Ocean Imagery Handler API (FastAPI / Uvicorn)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=ocean-imagery
Group=ocean-imagery
WorkingDirectory=/opt/ocean-imagery-handler
EnvironmentFile=/etc/ocean-imagery-handler/env
ExecStart=/opt/ocean-imagery-handler/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8100
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
